do
	local ok = pcall(function()
		local C = rawget(getgenv(), "Config")
		if type(C) == "table" then
			local flat = {
				["Main Account Race"] = "MainAccountRace",
				["Kill Aura"] = "KillAura",
				["Method Find Full Moon"] = "MethodFindFullMoon",
				["Hop Mode"] = "HopMode",
				["Time Wait Full Moon"] = "TimeWaitFullMoon",
				["Hop Near While Train"] = "HopNearWhileTrain",
			}
			for newKey, oldKey in pairs(flat) do
				if C[newKey] ~= nil then C[oldKey] = C[newKey] end
			end
			local vip = C["Server Vip"]
			if type(vip) == "table" then
				if vip["Block Hop"] ~= nil then vip.BlockHop = vip["Block Hop"] end
				if vip["Shutdown Game After"] ~= nil then vip.ShutdownGameAfter = vip["Shutdown Game After"] end
			end
		end
	end)
	if not ok then warn("not ok") end
end

