				local okF, res = pcall(fmFetchDirect)
				if okF then servers = res end
			end
			if type(servers) ~= "table" then
				local okP, res = pcall(fmFetchProxy)
				if okP then servers = res end
			end
			if type(servers) ~= "table" then return nil end
			local crewNeed = tonumber(type(readyCache) == "table" and readyCache.expected or nil)
				or (1 + #(type(G) == "table" and type(G.groupHelpers) == "table" and G.groupHelpers or {}))
