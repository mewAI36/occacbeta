local function getWaterY()
	local map = workspace:FindFirstChild("Map")
	local plane = map and map:FindFirstChild("WaterBase-Plane")
	if plane and plane:IsA("BasePart") then return plane.Position.Y end
	return 0
end

local waterY_current = getWaterY()
getgenv().waterY = waterY_current
_G.waterY = waterY_current
pcall(function()
	local env = getfenv and getfenv(0)
	if env and type(env) == "table" then env.waterY = waterY_current end
end)

pcall(function()
	local mt = getrawmetatable and getrawmetatable(getgenv())
	if mt and not mt.__waterY_patched then
		local oldIndex = mt.__index
		if setreadonly then setreadonly(mt, false) end
		mt.__index = function(t, k)
			if k == "waterY" then return getWaterY() end
			if type(oldIndex) == "function" then return oldIndex(t, k) end
			if type(oldIndex) == "table" then return oldIndex[k] end
			return nil
		end
		mt.__waterY_patched = true
		if setreadonly then setreadonly(mt, true) end
	end
end)

-- [LAYER 2] Dynamic API Hook: Thay thế core.KillSea bằng hàm fix chuẩn
task.spawn(function()
	local LP = game:GetService("Players").LocalPlayer
	local VIM = game:GetService("VirtualInputManager")

	local function aliveRoot()
		local char = LP.Character
		if not char then return nil, nil, nil end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if char.Parent and hrp and hrp.Parent and hum and hum.Health > 0 then return char, hrp, hum end
		return nil, nil, nil
	end

	local seaSkillSeen = {}
	local seaSkillDodgeUntil = 0
	local function seaSkillActive()
		local origin = workspace:FindFirstChild("_WorldOrigin")
		if origin then
			for _, c in ipairs(origin:GetChildren()) do
				if (c.Name == "ChargeUp" or c.Name == "SpinSlash") and not seaSkillSeen[c] then
					seaSkillSeen[c] = true
					seaSkillDodgeUntil = tick() + 1.25
				end
			end
		end
		return tick() < seaSkillDodgeUntil
	end

	local function castKeys(keys, delay)
		for _, key in ipairs(keys) do
			pcall(function() VIM:SendKeyEvent(true, key, false, game) end)
			task.wait(delay)
			pcall(function() VIM:SendKeyEvent(false, key, false, game) end)
		end
	end

	local function FixedKillSea(model)
		if typeof(model) ~= "Instance" or not model.Parent then return false end
		local function seaAlive()
			local hp = model:FindFirstChild("Health")
			return hp ~= nil and (tonumber(hp.Value) or 0) > 0
		end

		local startHum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
		if startHum and startHum.Sit then
			pcall(function() startHum.Sit = false end)
			task.wait(1)
		end

		local API = getgenv().OrcaHubAPI
		local core = API and API.core

		local retreating = false
		while model.Parent and seaAlive() do
			local char, hrp, myHum = aliveRoot()
			if not (char and hrp and myHum and myHum.Health > 0) then break end
			local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
			if not head then break end
			local headPos = head.Position
			local headTopY = headPos.Y
			if head:IsA("BasePart") then headTopY = headPos.Y + head.Size.Y * 0.5 end
			local waterY = getWaterY()
			local baseY = math.max(headTopY, waterY)
			local ratio = (myHum.MaxHealth > 0) and (myHum.Health / myHum.MaxHealth) or 1

			local fleeRef = nil
			if core and core.SeaEventEngine and core.EventRef then
				local evt = core.SeaEventEngine()
				if evt then fleeRef = core.EventRef(evt) end
			end

			if fleeRef then
				if core and core.TweenTo then
					pcall(core.TweenTo, CFrame.new(fleeRef.Position + Vector3.new(0, 2000, 0)), 900)
				else
					hrp.CFrame = CFrame.new(fleeRef.Position + Vector3.new(0, 2000, 0))
				end
				task.wait(0.05)
			else
				local skillActive = seaSkillActive()
				if ratio < 0.35 or skillActive then retreating = true end
				if retreating and not skillActive and ratio > 0.5 then retreating = false end

				if retreating then
					local angle = tick() * 3
					local dodgeRadius = 50
					local dodgePos = Vector3.new(
						headPos.X + math.cos(angle) * dodgeRadius,
						math.max(baseY + 200, waterY + 245),
						headPos.Z + math.sin(angle) * dodgeRadius
					)
					local targetCf = CFrame.lookAt(dodgePos, headPos)
					local dist = (hrp.Position - targetCf.Position).Magnitude
					if dist > 25 and core and core.TweenTo then
						pcall(core.TweenTo, targetCf, 300)
					else
						hrp.CFrame = targetCf
					end
					if hrp.Position.Y < waterY + 45 then
						local p = hrp.Position
						hrp.CFrame = CFrame.new(p.X, waterY + 45, p.Z)
					end
					task.wait(0.05)
				else
					local angle = tick() * 2
					local attackRadius = 30
					local attackPos = Vector3.new(
						headPos.X + math.cos(angle) * attackRadius,
						math.max(baseY + 45, waterY + 45),
						headPos.Z + math.sin(angle) * attackRadius
					)
					local targetCf = CFrame.lookAt(attackPos, headPos)
					local dist = (hrp.Position - targetCf.Position).Magnitude
					if dist > 35 and core and core.TweenTo then
						pcall(core.TweenTo, targetCf, 250)
					else
						hrp.CFrame = targetCf
					end

					if core and core.EquipBest then pcall(core.EquipBest) end
					if core and core.enableHaki then pcall(core.enableHaki) end

					local tool = char:FindFirstChildWhichIsA("Tool")
					if tool then pcall(function() tool:Activate() end) end

					pcall(function()
						local cam = workspace.CurrentCamera
						if cam then cam.CFrame = CFrame.lookAt(cam.CFrame.Position, headPos) end
					end)

					if core and core.AttackTarget then
						pcall(core.AttackTarget, model)
					end

					pcall(castKeys, { "Z", "X", "C" }, 0.1)

					if hrp.Position.Y < waterY + 45 then
						local p = hrp.Position
						hrp.CFrame = CFrame.new(p.X, waterY + 45, p.Z)
					end
					task.wait(0.05)
				end
			end
		end
		return not seaAlive()
	end

	for _ = 1, 600 do -- đợi tối đa 60s
		local API = getgenv().OrcaHubAPI
		if API and type(API.core) == "table" then
			API.core.KillSea = FixedKillSea
			break
		end
		task.wait(0.1)
	end
end)

