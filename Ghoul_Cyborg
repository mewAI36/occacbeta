pcall(function()
    if not atBossCenter then
        getgenv().atBossCenter = function(bossName)
            local API = getgenv().OrcaHubAPI
            local core = API and API.core
            local HOP = API and API.HOP
            if not (core and core.HRP) then return true end
            local hrp = core.HRP()
            local center = HOP and HOP.BossCenter and HOP.BossCenter(bossName or "Tyrant of the Skies")
            if center and hrp then
                return (hrp.Position - center.Position).Magnitude <= 800
            end
            return true
        end
    end

    if not getgenv().OrcaHubAPI then
        getgenv().OrcaHubAPI = {}
    end
end)

