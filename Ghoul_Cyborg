local RS = game:GetService("ReplicatedStorage")
local CommF = RS:WaitForChild("Remotes"):WaitForChild("CommF_")
local LP = game:GetService("Players").LocalPlayer

local function filterRemote(self, cmd, ...)
	if self == CommF and type(cmd) == "string" then
		local API = getgenv().OrcaHubAPI
		local core = API and API.core
		local HOP = API and API.HOP
		local curFrags = (core and core.Fragments and core.Fragments()) or (LP:FindFirstChild("Data") and LP.Data:FindFirstChild("Fragments") and LP.Data.Fragments.Value) or 0
		local target = (getgenv().Config and getgenv().Config["Farm Fragment"] and getgenv().Config["Farm Fragment"].Fragment) or 10000

		if cmd == "TravelDressrosa" and curFrags < target then
			if HOP and HOP.HopBoss then
				task.spawn(function() HOP.HopBoss("Tyrant of the Skies") end)
			end
			return false
		end

		if cmd == "TravelZou" then
			local enemies = workspace:FindFirstChild("Enemies")
			local order = (enemies and enemies:FindFirstChild("Order")) or workspace:FindFirstChild("Order")
			if order and order:FindFirstChild("Humanoid") and order.Humanoid.Health > 0 then
				return false
			end
		end
	end
	return true
end

if hookmetamethod then
	local oldNamecall
	oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
		local method = getnamecallmethod()
		if method == "InvokeServer" and self == CommF then
			local args = { ... }
			if not filterRemote(self, args[1], ...) then
				return nil
			end
		end
		return oldNamecall(self, ...)
	end))
end

if hookfunction then
	local oldInvoke
	oldInvoke = hookfunction(CommF.InvokeServer, newcclosure(function(self, ...)
		local args = { ... }
		if not filterRemote(self, args[1], ...) then
			return nil
		end
		return oldInvoke(self, ...)
	end))
end

task.spawn(function()
	while true do
		task.wait(0.5)
		local API = getgenv().OrcaHubAPI
		local core = API and API.core
		if core and core.KillMonster and core.EquipBest then
			local enemies = workspace:FindFirstChild("Enemies")
			local order = (enemies and enemies:FindFirstChild("Order")) or workspace:FindFirstChild("Order")
			if order and order:FindFirstChild("Humanoid") and order.Humanoid.Health > 0 then
				pcall(function()
					core.EquipBest()
					core.KillMonster(order, 250)
				end)
			end
		end
	end
end)

